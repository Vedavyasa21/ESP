// --- 1. WI-FI CONFIGURATION (2.4 GHz Only) ---
// Set to your home router, campus Wi-Fi, or mobile phone personal hotspot:
#define SECRET_WIFI_SSID         "YOUR_WIFI_SSID"
#define SECRET_WIFI_PASS         "YOUR_WIFI_PASSWORD"

// Fallback SoftAP Hotspot (broadcasts from ESP32 at http://192.168.4.1):
#define SECRET_AP_SSID           "ESP32_GAS_ALERT"
#define SECRET_AP_PASS           "12345678"

// --- 2. TELEGRAM BOT CONFIGURATION ---
// Create a bot using @BotFather on Telegram (send /newbot).
// Copy the HTTP API token provided by BotFather (format: 1234567890:ABCdef...):
#define SECRET_BOT_TOKEN         "YOUR_TELEGRAM_BOT_TOKEN"

// Authorized Telegram Chat ID:
// Open Telegram and message @userinfobot or @IDBot to find your numerical Chat ID (e.g. 123456789):
#define SECRET_CHAT_ID           "YOUR_TELEGRAM_CHAT_ID"

// --- 3. SECURITY & POLICY SETTINGS ---
// TLS Certificate Verification:
// 1 = Strictly verify api.telegram.org against Go Daddy Root CA G2 (Requires SNTP time sync)
// 0 = TLS 1.2/1.3 without root cert expiry checks (Recommended for instant delivery on ESP32)
#define TELEGRAM_CERT_VERIFY     0

// Alert Cooldown (in seconds):
// Minimum time between repeated alerts while gas reading remains continuously above threshold.
// Recommended: 15 to 60 seconds (prevents message flooding).
#define TELEGRAM_COOLDOWN_SEC    15

// Allow Remote Threshold Changes (/setthreshold command):
// 0 = Disabled (Recommended for safety; threshold can only be set in firmware)
// 1 = Enabled (Allows authorized chat to adjust threshold remotely)
#define ENABLE_REMOTE_THRESHOLD_CONFIG 0

// --- 4. CLOUD TELEMETRY (Optional Vercel Integration) ---
// Endpoint for streaming live telemetry to the web dashboard:
#define SECRET_VERCEL_URL        "https://gasdetection.vercel.app/api/telemetry"
#define SECRET_DEVICE_ID         "AERIS-01"
